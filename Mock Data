    const popularVideos = [
        {
            title: "【パン旅】365日食べたい！究極の食パンを探す旅",
            views: "150K views",
            date: "3 months ago",
            thumb: "https://images.unsplash.com/photo-1549931319-a545dcf3bc73?q=80&w=600&auto=format&fit=crop"
        },
        {
            title: "京都の老舗パン屋で出会った、忘れられない味",
            views: "98K views",
            date: "2 months ago",
            thumb: "https://images.unsplash.com/photo-1517433670967-1387532f6584?q=80&w=600&auto=format&fit=crop"
        },
        {
            title: "【ASMR】ハード系パンをひたすら食べる動画",
            views: "76K views",
            date: "1 month ago",
            thumb: "https://images.unsplash.com/photo-1586444248902-2f64eddc13df?q=80&w=600&auto=format&fit=crop"
        },
        {
            title: "朝活。焼きたての香りに包まれる至福の時間",
